<IfModule mod_headers.c>
    # Append Vary header for better caching
    <FilesMatch "\.(js|css|xml|gz|less|php)$">
        Header append Vary Accept-Encoding
    </FilesMatch>

    # Append Vary header based on the "accept" environment variable
    Header append Vary Accept env=REDIRECT_accept

    # Set Content Security Policy header
#    Header set Content-Security-Policy "default-src 'self' https://api.websitecarbon.com https://unpkg.com https://cdn.jsdelivr.net;"
    # Set X-Frame-Options header
    Header always append X-Frame-Options SAMEORIGIN

    # Set Referrer-Policy header
    Header set Referrer-Policy "no-referrer"

    # Set Permissions-Policy header
    Header set Permissions-Policy "geolocation=(self 'https://umer936.com'), microphone=()"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilter DEFLATE js css less
    AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml
</IfModule>

AddDefaultCharset UTF-8

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresDefault "access plus 6 months"
</IfModule>

ErrorDocument 404 /404.php

# Prevent directory listing
Options -Indexes

# Conference talks redirects - maintain backward compatibility with old URLs
# These redirect requests to old paths to the new submodule location
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect /cakefest-* and conference talk directories to submodule
    RewriteRule ^cakefest-2023(/.*)?$ conference-talks/talks/cakefest-2023$1 [L]
    RewriteRule ^cakefest-2024(/.*)?$ conference-talks/talks/cakefest-2024$1 [L]
    RewriteRule ^cakefest-2025(/.*)?$ conference-talks/talks/cakefest-2025$1 [L]
    RewriteRule ^SwRI_AI_Talk(/.*)?$ conference-talks/talks/SwRI_AI_Talk$1 [L]
    RewriteRule ^TMI-2026(/.*)?$ conference-talks/talks/TMI-2026$1 [L]
</IfModule>
